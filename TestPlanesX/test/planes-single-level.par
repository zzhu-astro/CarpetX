## 2D plane output on a single uniform level.
##
## Every grid function holds the analytic field f(x,y,z) = x + 100 y + 10000 z
## (see thorn TestPlanesX). The domain uses a distinct, non-zero origin per axis
## so that a writer assuming ProbLo == 0 or confusing axes is caught. All eight
## index-type centerings are written, on the three principal planes plus one
## off-centre elevation per direction.

ActiveThorns = "
    CarpetX
    PlanesX
    IOUtil
    TestPlanesX
"

Cactus::cctk_itlast = 0
Cactus::presync_mode = "mixed-error"

# Distinct cell count per axis (so a transposed in-plane axis is caught) and a
# distinct, non-zero origin per axis (so ProbLo==0 assumptions are caught).
# dx = 1 on every axis.
CarpetX::ncells_x = 16
CarpetX::ncells_y = 20
CarpetX::ncells_z = 24

CarpetX::xmin = -4.0
CarpetX::ymin = -2.0
CarpetX::zmin = -6.0
CarpetX::xmax = 12.0
CarpetX::ymax = 18.0
CarpetX::zmax = 18.0

CarpetX::boundary_x = "linear extrapolation"
CarpetX::boundary_y = "linear extrapolation"
CarpetX::boundary_z = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "linear extrapolation"
CarpetX::boundary_upper_z = "linear extrapolation"

CarpetX::max_num_levels = 1

# blocking_factor=2 keeps ncells (16,20,24) valid (the default 8 does not
# divide 20); small max_grid_size forces the domain into several boxes so that,
# run on >1 rank, the Silo MPI gather (MPI_Send/Recv) and multi-file metafile
# and the openPMD per-rank collective chunks are all exercised.
CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

# All eight centerings, written on the three principal planes (at the domain
# centre) plus one offset per direction.
PlanesX::silo_plane_vars = "
    TestPlanesX::gf000
    TestPlanesX::gf001
    TestPlanesX::gf010
    TestPlanesX::gf011
    TestPlanesX::gf100
    TestPlanesX::gf101
    TestPlanesX::gf110
    TestPlanesX::gf111
"
PlanesX::silo_planes = "xy:6.0, xz:8.0, yz:4.0, xy:8.0, xz:10.0, yz:2.0"
PlanesX::silo_planes_every = 1

PlanesX::openpmd_plane_vars = "
    TestPlanesX::gf000
    TestPlanesX::gf001
    TestPlanesX::gf010
    TestPlanesX::gf011
    TestPlanesX::gf100
    TestPlanesX::gf101
    TestPlanesX::gf110
    TestPlanesX::gf111
"
PlanesX::openpmd_planes = "xy:6.0, xz:8.0, yz:4.0, xy:8.0, xz:10.0, yz:2.0"
PlanesX::openpmd_planes_every = 1

PlanesX::planes_int_precision = 4
PlanesX::planes_frac_precision = 3
