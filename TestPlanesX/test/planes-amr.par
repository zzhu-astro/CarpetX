## 2D plane output on a 3-level AMR hierarchy.
##
## Identical field, domain and centerings as planes-single-level.par, but with
## three refinement levels covering a cube of half-width 4 about the domain
## centre (4,8,6): x in [0,8], y in [4,12], z in [2,10]. The first six planes
## pass through that cube, so each intersects every level -- exercising per-level
## snapping, the Silo AMR mrgtree level shadowing, and the openPMD
## per-(patch,level) hierarchy attributes. A seventh plane (xy:14.0, i.e. z=14)
## lies inside the domain but ABOVE the refined cube, so it intersects only the
## coarsest level (level 0): no coarse->fine parent-child relationship exists for
## it, so the Silo metafile must fall back to a plain multimesh (no mrgtree) --
## a single-level AMR child map is all-empty and crashes VisIt's DBFreeGroupelmap
## (see PlanesX/doc/plane_output.md). This case verifies that the mrgtree guard
## keys on the actual child count, not just max_num_levels>1. Because TestPlanesX
## re-applies the analytic field at initial and postregrid, every level holds f
## exactly, independent of prolongation.

ActiveThorns = "
    CarpetX
    PlanesX
    IOUtil
    TestPlanesX
"

Cactus::cctk_itlast = 0
Cactus::presync_mode = "mixed-error"

# Distinct cell count and non-zero origin per axis; dx = 1 on the coarse level.
CarpetX::ncells_x = 16
CarpetX::ncells_y = 20
CarpetX::ncells_z = 24

CarpetX::xmin = -4.0
CarpetX::ymin = -2.0
CarpetX::zmin = -6.0
CarpetX::xmax = 12.0
CarpetX::ymax = 18.0
CarpetX::zmax = 18.0

CarpetX::boundary_x = "linear extrapolation"
CarpetX::boundary_y = "linear extrapolation"
CarpetX::boundary_z = "linear extrapolation"
CarpetX::boundary_upper_x = "linear extrapolation"
CarpetX::boundary_upper_y = "linear extrapolation"
CarpetX::boundary_upper_z = "linear extrapolation"

# Three levels refining a cube of half-width 4 about the domain centre (4,8,6).
CarpetX::max_num_levels = 3
CarpetX::regrid_every = 1
Driver::regrid_error_threshold = 0.5

CarpetX::ghost_size = 1
# ddf prolongation fills the staggered coarse-fine ghost cells of a newly
# created level (the "conservative" interpolator leaves a face ghost layer
# unfilled until the next SYNC, which trips CarpetX's poison guard for
# cell-centred grid functions). With ddf the poison guard can stay on.
CarpetX::prolongation_type = "ddf"
CarpetX::prolongation_order = 1
CarpetX::poison_undefined_values = yes

CarpetX::blocking_factor_x = 2
CarpetX::blocking_factor_y = 2
CarpetX::blocking_factor_z = 2

# Small max_grid_size forces several boxes per level so that, run on >1 rank,
# the Silo MPI gather and openPMD per-rank collective chunks are exercised on
# every refinement level.
CarpetX::max_grid_size_x = 8
CarpetX::max_grid_size_y = 8
CarpetX::max_grid_size_z = 8

TestPlanesX::refined_center_x = 4.0
TestPlanesX::refined_center_y = 8.0
TestPlanesX::refined_center_z = 6.0
# Uniform half-size 4 on every level: levels 1 and 2 cover the same nominal cube
# (they differ only by a ~1-cell buffer/nesting shell), so each in-cube plane
# crosses all three levels. planes-amr-midlevel.par nests the levels instead.
TestPlanesX::refined_radius[0] = 4.0
TestPlanesX::refined_radius[1] = 4.0
TestPlanesX::refined_radius[2] = 4.0

IO::out_dir = $parfile
IO::out_every = 1
IO::out_fileinfo = "axis labels"
IO::parfile_write = no

CarpetX::out_metadata = no

# All eight centerings, written on the three principal planes (at the domain
# centre) plus one offset per direction (all inside the refined cube, so they
# cross every level), plus xy:14.0 which is inside the domain but above the cube
# and so intersects only the coarsest level (plain-multimesh / no-mrgtree path).
PlanesX::silo_plane_vars = "
    TestPlanesX::gf000
    TestPlanesX::gf001
    TestPlanesX::gf010
    TestPlanesX::gf011
    TestPlanesX::gf100
    TestPlanesX::gf101
    TestPlanesX::gf110
    TestPlanesX::gf111
"
PlanesX::silo_planes = "xy:6.0, xz:8.0, yz:4.0, xy:8.0, xz:10.0, yz:2.0, xy:14.0"
PlanesX::silo_planes_every = 1

# Pin the non-default ghost-extended slabs and explicit-name-list metafiles
# (the defaults are interior-only + nameschemes): this parfile is the
# coverage for the legacy metafile form and for ghost handling
# (DBOPT_LO/HI_OFFSET, ghost-extended extents) in the CI VisIt gate.
PlanesX::silo_planes_ghosts = yes
PlanesX::silo_planes_nameschemes = no

PlanesX::openpmd_plane_vars = "
    TestPlanesX::gf000
    TestPlanesX::gf001
    TestPlanesX::gf010
    TestPlanesX::gf011
    TestPlanesX::gf100
    TestPlanesX::gf101
    TestPlanesX::gf110
    TestPlanesX::gf111
"
PlanesX::openpmd_planes = "xy:6.0, xz:8.0, yz:4.0, xy:8.0, xz:10.0, yz:2.0, xy:14.0"
PlanesX::openpmd_planes_every = 1

PlanesX::planes_int_precision = 4
PlanesX::planes_frac_precision = 3
